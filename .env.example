# ============================================================
# Змінні оточення для «Фірмової Штори»
# Додаються на Vercel: Project → Settings → Environment Variables.
# Після додавання потрібен новий деплой, інакше вони не підхопляться.
# ============================================================

# --- Сховище заявок (Upstash Redis, безкоштовний тариф) -----
# Створити базу: upstash.com → Redis → Create Database,
# далі вкладка REST API, скопіювати обидва рядки.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Доступ до адмінки --------------------------------------
# ADMIN_PASSWORD_HASH — це відбиток пароля (scrypt), а не сам пароль.
# Порахувати:   node tools/hash.mjs
# і вставити сюди рядок виду  scrypt$32768$....$....
ADMIN_PASSWORD_HASH=
# ADMIN_SESSION_SECRET — довгий випадковий рядок, ним підписується сесія:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Помічник у чаті ----------------------------------------
# Ключ OpenAI: platform.openai.com -> API keys.
# Без нього чат працює на заготовлених відповідях, сайт не ламається.
OPENAI_API_KEY=
# Модель — необовʼязково, за замовчуванням та, що в lib/model.js
OPENAI_MODEL=

# --- Дублювання заявок у Telegram (необовʼязково) ------------
# Бот створюється у @BotFather, chat_id групи можна взяти в @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Пароль менеджера (необовʼязково) ------------------------
# Окремий вхід для того, хто працює із заявками: він бачить заявки,
# базу клієнтів й історію чатів, але не може правити ціни, тексти
# й фото. Відбиток рахується так само:  node tools/hash.mjs
MANAGER_PASSWORD_HASH=
